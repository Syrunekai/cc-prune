# cc-prune local settings. Copy this file to .env (which is never committed) and edit it.
# A variable set in your environment wins over the value here.

# Named folders for `cc-prune export` and the window's Export tab: a JSON array.
# Quoted values may span several lines.
CC_PRUNE_EXPORT_DIRS='[
  {"name": "transcripts", "path": "~/Documents/claude-transcripts"},
  {"name": "archive", "path": "~/Archive/claude"}
]'

# The folder used when none is named. With a single folder above, that one is the default.
CC_PRUNE_EXPORT_DEFAULT=transcripts

# Speaker labels and time zone of exported transcripts (local, utc, or an offset like +2).
# CC_PRUNE_USER_NAME=Operator
# CC_PRUNE_ASSISTANT_NAME=Machine
# CC_PRUNE_TIMEZONE=local
